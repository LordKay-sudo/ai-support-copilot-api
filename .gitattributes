# Normalize text files to LF in the repository (reduces spurious diffs on Windows).
* text=auto

*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

Dockerfile text eol=lf
.dockerignore text eol=lf

mvnw text eol=lf
mvnw.cmd text eol=lf

*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
